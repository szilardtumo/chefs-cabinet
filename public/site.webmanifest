{
  "id": "/",
  "name": "Chef's Cabinet",
  "short_name": "Chef's Cabinet",
  "description": "Recipes, ingredients, cookbooks and shopping lists in one place.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#1b1b1b",
  "background_color": "#1b1b1b",
  "icons": [
    {
      "src": "/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Voice command",
      "url": "/dashboard?listen=true"
    },
    {
      "name": "Shopping list",
      "url": "/shopping"
    },
    {
      "name": "Recipes",
      "url": "/recipes"
    }
  ],
  "share_target": {
    "action": "/recipes/import",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
